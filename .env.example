# 区域健康档案接入与回执系统 —— 环境变量样例
#
# 复制为 .env 后按院内实际填写：cp .env.example .env
# 全部凭据只从环境变量读取；缺任一必需项进程在启动期非零退出，不会静默切到本地替身。
# 本文件内所有值均为占位样例，不含任何真实凭据。

# ===== 区域健康档案平台（MLLP 监听口，默认端口 2575）=====
ARCHIVE_MLLP_HOST=archive-platform.example.internal   # 本机监听地址；院内前置机通常绑 0.0.0.0
ARCHIVE_MLLP_PORT=2575                                 # 区域平台约定的 MLLP 监听端口
ARCHIVE_LOCAL_AET=CHSCOMMUNITY                        # 本院 Application Entity Title
ARCHIVE_REMOTE_AET=REGIONAL_ARCHIVE                    # 对端 AE Title；不在白名单的连接被拒

# 回执方言：framed_ack = 回 0B 06 1C 0D；bare_ack = 回裸 0x06（部分区域平台实现如此）
ARCHIVE_ACK_MODE=framed_ack

# ===== 重投目标（差集算出缺失后，把台账里的报文原样发回这个 MLLP 入口）=====
# 与上面的监听口通常不是同一台机器：监听口在本院前置机上，重投指向区域平台
# （或院内接口引擎）的 MLLP 入口；对端回 MSA-1=AA 才算这条被收下。
ARCHIVE_REDELIVERY_HOST=archive-platform.example.internal
ARCHIVE_REDELIVERY_PORT=2575

# ===== 出站重连预算（断线自愈；全部可留空走默认）=====
# 重投过程中对端关掉连接时，客户端按「记一笔 → 关旧连接 → 建新连接 → 重发同一份字节」自愈。
# 这几个值决定重试几次、每次退多久。院内走专线与走公网的合理取值不同，故配置化。
ARCHIVE_MLLP_RECONNECT_MAX_ATTEMPTS=3     # 含首次的最大尝试次数（1..10）
ARCHIVE_MLLP_RECONNECT_BASE_MS=200        # 首次失败后的退避基数
ARCHIVE_MLLP_RECONNECT_MAX_MS=2000        # 退避封顶（须 ≥ BASE）
ARCHIVE_MLLP_CONNECT_TIMEOUT_MS=5000      # 建连超时
ARCHIVE_MLLP_READ_TIMEOUT_MS=15000        # 读对端回执超时

# ===== 台账库（生产 PostgreSQL；单机可用 H2 PG 兼容模式）=====
ARCHIVE_DB_URL=jdbc:postgresql://127.0.0.1:5432/regional_archive
ARCHIVE_DB_USERNAME=archive_app
ARCHIVE_DB_PASSWORD=REPLACE_ME_DB_PASSWORD   # 台账库口令

# ===== 院内 HIS 患者主索引（写：确认后才 PUT）=====
HIS_MPI_ENDPOINT=http://his-mpi.example.internal:8080   # 实际路径为 {HIS_MPI_ENDPOINT}/patient-index
HIS_MPI_TOKEN=REPLACE_ME_HIS_MPI_TOKEN      # HIS 患者主索引的 Bearer 令牌

# ===== 区域平台回执对账（读：次日核对哪几条没收到）=====
ARCHIVE_ACK_API_BASE_URL=https://archive-platform.example.internal/api/v1
ARCHIVE_ACK_API_TOKEN=REPLACE_ME_ACK_API_TOKEN # 区域平台回执查询令牌

# ===== 对院内既有系统开放的 HTTP API（确认动作的入口）=====
ARCHIVE_API_TOKEN=REPLACE_ME_API_TOKEN      # 院内既有系统调用本接口的令牌

# ===== 模型网关（仅 OpenAI-compatible；模型只做字段语义对齐与身份候选，不决定状态）=====
MODEL_BASE_URL=https://model-gateway.example.internal/v1
MODEL_API_KEY=REPLACE_ME_MODEL_API_KEY        # 模型网关密钥
MODEL_NAME=REPLACE_ME_MODEL_NAME             # 已部署的模型名
MODEL_TIMEOUT_SECONDS=15        # 单次调用超时
MODEL_MAX_RETRIES=2             # 仅连接/读超时重试，其余错误直接降级